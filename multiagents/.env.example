# Anthropic (required for Mahm agent)
ANTHROPIC_API_KEY=

# OpenAI — required for LLM intent detection (GPT-4o). Add your key in multiagents/.env:
# OPENAI_API_KEY=sk-proj-...   (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Proxies to Person A (data-apis) and Person C (backend)
# Run data-apis on 3001, backend on 5000 when testing full flow
DATA_APIS_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000

# Optional: when deployed, set to your app URL for tool callbacks
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bright Data for ingredient scraping (POST /api/scrape-ingredient)
# Get key from https://brightdata.com/cp/setting/users
# Dataset ID from your Web Scraper zone (discover_new by keyword)
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=gd_l95fol7l1ru6rlo116
